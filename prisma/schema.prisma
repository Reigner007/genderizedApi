generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  String   @id
  name                String   @unique
  gender              String?
  genderProbability   Float?
  sampleSize          Int?
  age                 Int?
  ageGroup            String?
  countryId           String?
  countryProbability  Float?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("profiles")
}